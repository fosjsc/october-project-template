DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

LOG_CHANNEL=single
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file-custom
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=
